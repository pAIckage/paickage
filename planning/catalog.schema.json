{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAiCKAGE architecture catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "architecture_standard",
    "packages"
  ],
  "properties": {
    "$schema": {
      "const": "catalog.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "architecture_standard": {
      "const": "standards/architecture.md#revision-0001"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "scope": {
      "allOf": [
        {
          "$ref": "#/$defs/facet"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      ]
    },
    "layer": {
      "allOf": [
        {
          "$ref": "#/$defs/facet"
        },
        {
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "dependencies": {
      "allOf": [
        {
          "$ref": "#/$defs/facet"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^paickage/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      ]
    },
    "extensions": {
      "allOf": [
        {
          "$ref": "#/$defs/facet"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^ext-[a-z0-9][a-z0-9_-]*$"
              }
            }
          }
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "namespace",
        "directory",
        "description",
        "tracking_issue",
        "research_refs",
        "architecture"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^paickage/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^Paickage\\\\[A-Z][A-Za-z0-9]*$"
        },
        "directory": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^packages/[a-z][a-z0-9-]*$"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tracking_issue": {
          "type": "string",
          "pattern": "^https://github.com/(?:paickage|pAIckage)/paickage/issues/[1-9][0-9]*$"
        },
        "research_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "layer",
            "dependencies",
            "extensions"
          ],
          "properties": {
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "layer": {
              "$ref": "#/$defs/layer"
            },
            "dependencies": {
              "$ref": "#/$defs/dependencies"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          }
        }
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_researched",
            "proposed",
            "verified",
            "approved",
            "requires_review",
            "rejected"
          ]
        },
        "value": {},
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_researched"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "proposed",
                  "verified",
                  "approved"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "approved"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "approval_ref"
            ]
          }
        }
      ]
    }
  }
}
