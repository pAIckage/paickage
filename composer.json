{
    "name": "paickage/workspace",
    "description": "Development workspace for independently distributable PAiCKAGE PHP packages.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.4.27 || ~8.5.12"
    },
    "require-dev": {
        "opis/json-schema": "^2.6.2",
        "pestphp/pest": "^5.3.7"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "validate-catalog": "@php scripts/validation/validate.php",
        "dependency-graph": "@php scripts/validation/validate.php --graph",
        "test-tooling": "pest --compact"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
